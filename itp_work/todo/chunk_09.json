 {
  "off": 1474772,
  "len": 142,
  "slack": 1,
  "jp": "《アップタイド》\n２時間、水位を上昇させる支援魔法です。\n重ねがけすると、持続時間はリセットされます。\n減水中の場合は、その効果を打ち消します。\n"
 },
 {
  "off": 1474916,
  "len": 141,
  "slack": 2,
  "jp": "《ダウンタイド》\n２時間、水位を下降させる支援魔法です。\n重ねがけすると、持続時間はリセットされます。\n増水中の場合は、その効果を打ち消します。"
 },
 {
  "off": 1475060,
  "len": 133,
  "slack": 2,
  "jp": "《ヴァニッシュ》\n敵一体に大ダメージを与える攻撃魔法です。\n効果は詠唱者の魔力や目標の魔法防御に\n左右されます。射程３の発生型魔法です。"
 },
 {
  "off": 1475196,
  "len": 133,
  "slack": 2,
  "jp": "《ブレス》\n味方の全ネイティアルのＨＰを１ポイントずつ\n回復させる魔法です。ユニットとの距離は\n無関係で、マップ全体に影響を及ぼします。"
 },
 {
  "off": 1475332,
  "len": 145,
  "slack": 2,
  "jp": "《メディック》\n行動不能（金化・銀化・凍結）に陥ったユニットを\n正常に戻す支援魔法です。ペリットの持つ\nメディックと異なり、射程３の発生型魔法です。"
 },
 {
  "off": 1475480,
  "len": 125,
  "slack": 2,
  "jp": "《コンジュレート》\n敵１体を金属に変化させる支援魔法です。\n詠唱者の魔力によって効果時間が異なります。\n射程３の発生型魔法です。"
 },
 {
  "off": 1475608,
  "len": 24,
  "slack": 3,
  "jp": "魔法を所持していません。"
 },
 {
  "off": 1475636,
  "len": 154,
  "slack": 1,
  "jp": "強敵を求め、さすらう女戦士。\n攻撃力・防御力・素早さが高く\n手堅い戦士型マスターと言える。\nその分魔力は低い。接近戦では、\n強力な跳び蹴りが頼りになるだろう。"
 },
 {
  "off": 1475792,
  "len": 142,
  "slack": 1,
  "jp": "野望に燃える若き公爵。\n高い魔力と素早さを両立した魔力型\nマスター。防御面は見劣りし、\n移動力が３しかないのが弱点だ。\n突剣による隣接攻撃が可能。"
 },
 {
  "off": 1475936,
  "len": 144,
  "slack": 3,
  "jp": "流れるままに生きる漂泊の剣客。\n攻撃力が高く、魔力も高めの\nバランス型マスターと言える。\n弱点は低めの防御力か。強力な\n隣接攻撃・居合い斬りを持つ。"
 },
 {
  "off": 1476084,
  "len": 142,
  "slack": 1,
  "jp": "ほまれ高き忠義の老騎士。\n攻撃力・防御力が最強であり、\n非常に固い戦士型マスターだ。\n魔力・素早さに欠けるのが欠点。\nランスによる隣接攻撃が可能。"
 },
 {
  "off": 1476228,
  "len": 148,
  "slack": 3,
  "jp": "闇を討ちはらう聖騎士。\n聖騎士らしく、攻撃力・魔力が高い\n魔力型マスターだ。防御面も優秀で\n隙が無いが、非常に遅いのは難点。\n聖剣による隣接攻撃が可能。"
 },
 {
  "off": 1476380,
  "len": 142,
  "slack": 1,
  "jp": "光に焦がれる影の眷族。\n素早さと移動力が高く、典型的な\n機動型マスターと言える。\n防御力・魔法防御は低いため注意。\n手裏剣は射程４の遠距離攻撃だ。"
 },
 {
  "off": 1476524,
  "len": 152,
  "slack": 3,
  "jp": "深き森の護人（まもりびと）。\n平均的な能力を持つバランス型\nマスター。ただし手にした弓は射程が\n６あり、全マスター中最高クラスだ。\n高所を取れば有利だろう。"
 },
 {
  "off": 1476680,
  "len": 140,
  "slack": 3,
  "jp": "復讐心に燃える猛き蛮人。\n素早く、移動力が５ある戦士型\nマスターで攻撃力・防御力も\n非常に高い。ただし魔力は最弱だ。\n射程４の岩投げ攻撃が可能。"
 },
 {
  "off": 1476824,
  "len": 146,
  "slack": 1,
  "jp": "果てぬ夢を追いつづける盗賊。\n非常に素早く、移動力は６ある。\n機動力は最高のマスターだ。\nただし防御や魔力は低い。\n投げナイフの射程は５、中々便利だ。"
 },
 {
  "off": 1476972,
  "len": 146,
  "slack": 1,
  "jp": "希望の歌を紡ぎだす吟遊詩人。\n魔力が高めの魔力型マスターで、\n素早さもある。だが防御面は\n貧弱なため、十分注意しよう。\n歌による隣接攻撃は弱いだろう。"
 }
]
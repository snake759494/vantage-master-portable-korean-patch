[
 {
  "off": 1472380,
  "len": 164,
  "slack": 3,
  "jp": "破滅の言葉が記されているという巻き物。\nその言葉を唱えると魔物が現れ、\nその者の魂を抜き取って行くといわれている。\n天のネイティアル、\nレグナ・クロックスを召喚できる。"
 },
 {
  "off": 1472548,
  "len": 10,
  "slack": 1,
  "jp": "潤水の秘石"
 },
 {
  "off": 1472560,
  "len": 219,
  "slack": 0,
  "jp": "その昔、大干ばつが世界を覆ったとき、\n祈祷師が雨乞いのために作り出したとされる石。\n願いを込めて天にかざすと、\nたちどころに雨雲が現れ大地を潤したという。\n水位を上昇させる魔法、\nアップタイドを唱えることができるようになる。"
 },
 {
  "off": 1472780,
  "len": 10,
  "slack": 1,
  "jp": "渇水の秘石"
 },
 {
  "off": 1472792,
  "len": 227,
  "slack": 0,
  "jp": "その昔、長雨が続き大地が水没しそうになった時、\n祈願師が雲払いのために作り出したとされる石。\n願いを込めて天にかざすと、\nたちどころに空が晴れ、水が引いたという。\n水位を下降させる魔法、\nダウンタイドを唱えることができるようになる。"
 },
 {
  "off": 1473020,
  "len": 10,
  "slack": 1,
  "jp": "猛滅の魔刀"
 },
 {
  "off": 1473032,
  "len": 184,
  "slack": 3,
  "jp": "悪魔の力が封じられているという刀。\n呪いを込めて敵に刃を向けると、\n魔力の刃が敵を突き刺すと伝えられている。\n敵に大きなダメージを与える魔法、\nヴァニッシュを唱えることができるようになる。"
 },
 {
  "off": 1473220,
  "len": 10,
  "slack": 1,
  "jp": "祝福の琵琶"
 },
 {
  "off": 1473232,
  "len": 139,
  "slack": 0,
  "jp": "弦が４本の小さな楽器。\nその澄んだ音色は、聞く者の心を和ませる。\nネイティアルの体力を回復させる魔法、\nブレスを唱えることができるようになる。"
 },
 {
  "off": 1473372,
  "len": 10,
  "slack": 1,
  "jp": "還元の小像"
 },
 {
  "off": 1473384,
  "len": 172,
  "slack": 3,
  "jp": "乳白色の石で造られた天使の小像。\nこの石に触れると、\n穏やかな安息が得られるという。\n行動不能になったネイティアルを正常に戻す魔法、\nメディックを唱えることができるようになる。"
 },
 {
  "off": 1473560,
  "len": 10,
  "slack": 1,
  "jp": "変化の魔杖"
 },
 {
  "off": 1473572,
  "len": 195,
  "slack": 0,
  "jp": "金の飾りが付いた長い杖。\n変化の魔法が込められており、\n対象を何でも思うものに\n変化させることができるといわれている。\n敵を一定時間行動不能にする魔法、\nコンジュレートを唱えることができるようになる。"
 },
